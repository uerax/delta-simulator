/* pages/index/index.wxss */
page {
  background-color: #1e1e2e;
  color: #cdd6f4;
  min-height: 100vh;
}

.portal-container {
  padding: 32rpx;
  display: flex;
  flex-direction: column;
  gap: 28rpx;
}

/* 顶部精简玩家栏 */
.top-bar {
  background: #313244;
  border-radius: 28rpx;
  padding: 24rpx 28rpx;
  display: flex;
  justify-content: space-between;
  align-items: center;
  box-shadow: 0 6rpx 20rpx rgba(0, 0, 0, 0.2);
}

.player-profile {
  display: flex;
  align-items: center;
}

.avatar-btn {
  background: transparent !important;
  padding: 0 !important;
  margin: 0 !important;
  width: 96rpx !important;
  height: 96rpx !important;
  min-height: 0 !important;
  border-radius: 48rpx;
  border: 3rpx solid #89b4fa;
  overflow: hidden;
  display: flex;
  align-items: center;
  justify-content: center;
}

.avatar-btn::after {
  border: none;
}

.avatar-img {
  width: 100%;
  height: 100%;
}

.player-texts {
  margin-left: 20rpx;
  display: flex;
  flex-direction: column;
}

.nickname-box {
  display: flex;
  align-items: center;
}

.nickname-input {
  font-size: 32rpx;
  font-weight: bold;
  color: #cdd6f4;
  max-width: 260rpx;
}

.daily-badge {
  font-size: 22rpx;
  color: #a6adc8;
  margin-top: 6rpx;
}

.coin-badge {
  background: #1e1e2e;
  padding: 12rpx 24rpx;
  border-radius: 30rpx;
  display: flex;
  align-items: center;
  border: 1rpx solid #45475a;
}

.coin-icon {
  font-size: 28rpx;
  margin-right: 8rpx;
}

.coin-num {
  font-size: 28rpx;
  font-weight: bold;
  color: #fab387;
}

/* 标题栏 */
.section-title-bar {
  display: flex;
  justify-content: space-between;
  align-items: baseline;
  margin-top: 6rpx;
  padding: 0 8rpx;
}

.section-title {
  font-size: 36rpx;
  font-weight: bold;
  color: #bac2de;
}

.section-sub {
  font-size: 24rpx;
  color: #6c7086;
}

/* 游戏卡片列表 */
.game-cards-list {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

.game-card {
  background: #313244;
  border-radius: 28rpx;
  padding: 30rpx 32rpx;
  display: flex;
  flex-direction: column;
  box-shadow: 0 8rpx 24rpx rgba(0, 0, 0, 0.25);
  border: 2rpx solid #45475a;
  transition: all 0.15s ease-out;
}

.game-card:active {
  transform: scale(0.98);
  border-color: #89b4fa;
}

/* 上半部分：图标 + 标题/描述 */
.card-main {
  display: flex;
  align-items: flex-start;
  width: 100%;
}

.game-icon-box {
  width: 110rpx;
  height: 110rpx;
  border-radius: 26rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  box-shadow: 0 6rpx 16rpx rgba(0, 0, 0, 0.3);
}

.game-icon {
  font-size: 56rpx;
}

.game-icon-img {
  width: 86rpx;
  height: 86rpx;
  display: block;
}

.game-info {
  margin-left: 24rpx;
  flex: 1;
  min-width: 0; /* 关键：防止 flex 子项文字被挤压换行 */
  display: flex;
  flex-direction: column;
}

.game-header {
  display: flex;
  align-items: center;
  flex-wrap: nowrap;
}

.game-title {
  font-size: 34rpx;
  font-weight: bold;
  color: #cdd6f4;
  white-space: nowrap;
}

.game-tag {
  font-size: 20rpx;
  color: #f9e2af;
  background: rgba(249, 226, 175, 0.15);
  padding: 4rpx 14rpx;
  border-radius: 12rpx;
  margin-left: 14rpx;
  white-space: nowrap;
}

.game-desc {
  font-size: 24rpx;
  color: #a6adc8;
  margin-top: 10rpx;
  line-height: 1.45;
}

/* 分割线 */
.card-divider {
  height: 1rpx;
  background: #45475a;
  margin: 22rpx 0 18rpx;
  width: 100%;
}

/* 下半部分：战绩与进入按钮 */
.card-footer {
  display: flex;
  justify-content: space-between;
  align-items: center;
  width: 100%;
}

.game-record {
  display: flex;
  align-items: center;
  font-size: 24rpx;
}

.record-label {
  color: #a6adc8;
}

.record-val {
  color: #a6e3a1;
  font-weight: bold;
}

.enter-btn-pill {
  background: linear-gradient(135deg, #89b4fa, #b4befe);
  color: #11111b;
  font-size: 26rpx;
  font-weight: bold;
  padding: 10rpx 28rpx;
  border-radius: 30rpx;
  display: flex;
  align-items: center;
  box-shadow: 0 4rpx 14rpx rgba(137, 180, 250, 0.35);
}

.btn-text {
  line-height: 1.4;
}

.btn-arrow {
  margin-left: 6rpx;
  font-size: 30rpx;
  line-height: 1;
}

/* 底部设置 */
.footer-settings {
  margin-top: 10rpx;
  background: #272838;
  border-radius: 24rpx;
  padding: 20rpx 32rpx;
  display: flex;
  justify-content: space-around;
  align-items: center;
}

.setting-item {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.setting-text {
  font-size: 26rpx;
  color: #a6adc8;
}

.clear-data-text {
  font-size: 24rpx;
  color: #f38ba8;
  padding: 8rpx 16rpx;
}
