/* pages/index/index.wxss */
page {
  background-color: #1e1e2e;
  color: #cdd6f4;
  min-height: 100vh;
}

.portal-container {
  padding: 32rpx;
  display: flex;
  flex-direction: column;
  gap: 28rpx;
}

/* 顶部精简玩家栏 */
.top-bar {
  background: #313244;
  border-radius: 28rpx;
  padding: 24rpx 28rpx;
  display: flex;
  justify-content: space-between;
  align-items: center;
  box-shadow: 0 6rpx 20rpx rgba(0, 0, 0, 0.2);
}

.player-profile {
  display: flex;
  align-items: center;
}

.avatar-box {
  width: 96rpx;
  height: 96rpx;
  border-radius: 48rpx;
  border: 3rpx solid #89b4fa;
  overflow: hidden;
  display: flex;
  align-items: center;
  justify-content: center;
}

.avatar-img {
  width: 100%;
  height: 100%;
}

.profile-sub-row,
.guest-sub-row {
  display: flex;
  align-items: center;
  gap: 10rpx;
  margin-top: 6rpx;
}

/* 游客态样式与登录引导 */
.guest-profile {
  display: flex;
  align-items: center;
  cursor: pointer;
}

.avatar-box-guest {
  width: 96rpx;
  height: 96rpx;
  border-radius: 48rpx;
  border: 3rpx dashed #6c7086;
  position: relative;
  display: flex;
  align-items: center;
  justify-content: center;
  background: rgba(30, 30, 46, 0.6);
  box-sizing: border-box;
}

.avatar-box-guest .avatar-img {
  opacity: 0.75;
}

.guest-dot {
  position: absolute;
  right: 2rpx;
  bottom: 2rpx;
  width: 18rpx;
  height: 18rpx;
  border-radius: 9rpx;
  background: #f9e2af;
  border: 2rpx solid #313244;
}

.guest-header {
  display: flex;
  align-items: center;
}

.guest-name {
  font-size: 32rpx;
  font-weight: bold;
  color: #cdd6f4;
  max-width: 200rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.guest-tag {
  font-size: 20rpx;
  color: #f9e2af;
  background: rgba(249, 226, 175, 0.15);
  border: 1rpx solid rgba(249, 226, 175, 0.35);
  padding: 2rpx 10rpx;
  border-radius: 6rpx;
  margin-left: 10rpx;
  font-weight: 500;
}

.login-prompt-pill {
  margin-top: 8rpx;
  background: linear-gradient(135deg, rgba(137, 180, 250, 0.25) 0%, rgba(180, 190, 254, 0.12) 100%);
  border: 1rpx solid #89b4fa;
  padding: 4rpx 16rpx;
  border-radius: 20rpx;
  display: inline-flex;
  align-items: center;
}

.login-prompt-text {
  font-size: 22rpx;
  color: #89b4fa;
  font-weight: bold;
}

.player-texts {
  margin-left: 20rpx;
  display: flex;
  flex-direction: column;
}

.nickname-box {
  display: flex;
  align-items: center;
}

.player-name {
  font-size: 32rpx;
  font-weight: bold;
  color: #cdd6f4;
  max-width: 260rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.daily-badge {
  font-size: 22rpx;
  color: #a6adc8;
  margin-top: 6rpx;
}

.coin-badge {
  background: #1e1e2e;
  padding: 12rpx 24rpx;
  border-radius: 30rpx;
  display: flex;
  align-items: center;
  border: 1rpx solid #45475a;
}

.coin-icon {
  font-size: 28rpx;
  margin-right: 8rpx;
}

.coin-num {
  font-size: 28rpx;
  font-weight: bold;
  color: #fab387;
}

/* 标题栏 */
.section-title-bar {
  display: flex;
  justify-content: space-between;
  align-items: baseline;
  margin-top: 6rpx;
  padding: 0 8rpx;
}

.section-title {
  font-size: 36rpx;
  font-weight: bold;
  color: #bac2de;
}

.section-sub {
  font-size: 24rpx;
  color: #6c7086;
}

/* 游戏卡片列表 */
.game-cards-list {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

.game-card {
  background: #313244;
  border-radius: 28rpx;
  padding: 30rpx 32rpx;
  display: flex;
  flex-direction: column;
  box-shadow: 0 8rpx 24rpx rgba(0, 0, 0, 0.25);
  border: 2rpx solid #45475a;
  transition: all 0.15s ease-out;
}

.game-card:active {
  transform: scale(0.98);
  border-color: #89b4fa;
}

/* 上半部分：图标 + 标题/描述 */
.card-main {
  display: flex;
  align-items: flex-start;
  width: 100%;
}

.game-icon-box {
  width: 110rpx;
  height: 110rpx;
  border-radius: 26rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  box-shadow: 0 6rpx 16rpx rgba(0, 0, 0, 0.3);
}

.game-icon {
  font-size: 56rpx;
}

.game-icon-img {
  width: 86rpx;
  height: 86rpx;
  display: block;
}

.game-info {
  margin-left: 24rpx;
  flex: 1;
  min-width: 0; /* 关键：防止 flex 子项文字被挤压换行 */
  display: flex;
  flex-direction: column;
}

.game-header {
  display: flex;
  align-items: center;
  flex-wrap: nowrap;
}

.game-title {
  font-size: 34rpx;
  font-weight: bold;
  color: #cdd6f4;
  white-space: nowrap;
}

.game-tag {
  font-size: 20rpx;
  color: #f9e2af;
  background: rgba(249, 226, 175, 0.15);
  padding: 4rpx 14rpx;
  border-radius: 12rpx;
  margin-left: 14rpx;
  white-space: nowrap;
}

.game-desc {
  font-size: 24rpx;
  color: #a6adc8;
  margin-top: 10rpx;
  line-height: 1.45;
}

/* 分割线 */
.card-divider {
  height: 1rpx;
  background: #45475a;
  margin: 22rpx 0 18rpx;
  width: 100%;
}

/* 下半部分：战绩与进入按钮 */
.card-footer {
  display: flex;
  justify-content: space-between;
  align-items: center;
  width: 100%;
}

.game-record {
  display: flex;
  align-items: center;
  font-size: 24rpx;
}

.record-label {
  color: #a6adc8;
}

.record-val {
  color: #a6e3a1;
  font-weight: bold;
}

.enter-btn-pill {
  background: linear-gradient(135deg, #89b4fa, #b4befe);
  color: #11111b;
  font-size: 26rpx;
  font-weight: bold;
  padding: 10rpx 28rpx;
  border-radius: 30rpx;
  display: flex;
  align-items: center;
  box-shadow: 0 4rpx 14rpx rgba(137, 180, 250, 0.35);
}

.btn-text {
  line-height: 1.4;
}

.btn-arrow {
  margin-left: 6rpx;
  font-size: 30rpx;
  line-height: 1;
}

/* 底部设置 */
.footer-settings {
  margin-top: 10rpx;
  background: #272838;
  border-radius: 24rpx;
  padding: 20rpx 32rpx;
  display: flex;
  justify-content: space-around;
  align-items: center;
}

.setting-item {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.setting-text {
  font-size: 26rpx;
  color: #a6adc8;
}

/* 特勤登录提醒与身份认证弹窗 */
.login-modal-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.75);
  backdrop-filter: blur(8px);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 1000;
  padding: 32rpx;
  box-sizing: border-box;
}

.login-modal-card {
  width: 100%;
  max-width: 620rpx;
  background: #181825;
  border: 2rpx solid #45475a;
  border-radius: 28rpx;
  padding: 36rpx;
  box-shadow: 0 16rpx 48rpx rgba(0, 0, 0, 0.6);
  box-sizing: border-box;
  animation: modalFadeIn 0.25s ease-out;
}

@keyframes modalFadeIn {
  from {
    opacity: 0;
    transform: scale(0.92);
  }
  to {
    opacity: 1;
    transform: scale(1);
  }
}

.login-modal-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 24rpx;
}

.modal-badge {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.modal-badge-icon {
  font-size: 32rpx;
}

.modal-badge-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #cdd6f4;
}

.modal-close-btn {
  font-size: 32rpx;
  color: #6c7086;
  padding: 8rpx 16rpx;
  cursor: pointer;
}

.login-modal-body {
  margin-bottom: 32rpx;
}

.modal-tip-box {
  background: rgba(49, 50, 68, 0.6);
  border-radius: 16rpx;
  padding: 20rpx;
  margin-bottom: 28rpx;
  border-left: 6rpx solid #89b4fa;
}

.modal-tip-title {
  font-size: 26rpx;
  font-weight: bold;
  color: #89b4fa;
  display: block;
  margin-bottom: 8rpx;
}

.modal-tip-desc {
  font-size: 22rpx;
  color: #a6adc8;
  line-height: 1.5;
  display: block;
}

.modal-profile-preview-card {
  background: rgba(49, 50, 68, 0.4);
  border: 1rpx solid #45475a;
  border-radius: 20rpx;
  padding: 24rpx;
  display: flex;
  align-items: center;
  gap: 20rpx;
}

.modal-preview-avatar {
  width: 96rpx;
  height: 96rpx;
  border-radius: 48rpx;
  border: 2rpx solid #89b4fa;
  flex-shrink: 0;
}

.modal-preview-info {
  display: flex;
  flex-direction: column;
  gap: 6rpx;
}

.modal-preview-name {
  font-size: 30rpx;
  font-weight: bold;
  color: #cdd6f4;
}

.modal-preview-status {
  font-size: 22rpx;
  color: #f9e2af;
}

.login-modal-footer {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
  align-items: center;
}

.modal-login-btn {
  width: 100% !important;
  background: linear-gradient(135deg, #89b4fa 0%, #b4befe 100%);
  color: #11111b !important;
  border-radius: 36rpx;
  height: 80rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  font-weight: bold;
  box-shadow: 0 6rpx 20rpx rgba(137, 180, 250, 0.35);
}

.modal-login-btn::after {
  border: none;
}

.modal-login-btn-icon {
  font-size: 28rpx;
}

.modal-login-btn-text {
  font-size: 28rpx;
  color: #11111b;
}

.modal-guest-btn {
  padding: 10rpx 20rpx;
  cursor: pointer;
}

.guest-btn-text {
  font-size: 22rpx;
  color: #6c7086;
  text-decoration: underline;
}
