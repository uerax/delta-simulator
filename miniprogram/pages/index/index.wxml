<view class="portal-container">
  <!-- 顶部精简玩家栏 -->
  <view class="top-bar">
    <!-- 已登录态：展示头像、昵称与今日战绩 -->
    <view wx:if="{{userProfile.isLoggedIn}}" class="player-profile">
      <view class="avatar-box">
        <image class="avatar-img" src="{{userProfile.avatarUrl}}" mode="aspectFill"></image>
      </view>
      <view class="player-texts">
        <view class="nickname-box">
          <text class="player-name">{{userProfile.nickName || '野生鼠鼠'}}</text>
        </view>
        <view class="profile-sub-row">
          <text class="daily-badge">今日已玩 {{todayRecord.plays}} 局</text>
        </view>
      </view>
    </view>

    <!-- 未登录态：点击呼出特勤身份登录提醒弹窗 -->
    <view wx:else class="player-profile guest-profile" bindtap="onOpenLoginModal">
      <view class="avatar-box-guest">
        <image class="avatar-img" src="{{userProfile.avatarUrl}}" mode="aspectFill"></image>
        <view class="guest-dot"></view>
      </view>
      <view class="player-texts">
        <view class="guest-header">
          <text class="guest-name">{{userProfile.nickName || '野生鼠鼠'}}</text>
          <text class="guest-tag">游客</text>
        </view>
        <view class="guest-sub-row">
          <view class="login-prompt-pill">
            <text class="login-prompt-text">微信一键登录 ›</text>
          </view>
        </view>
      </view>
    </view>

    <view class="coin-badge">
      <text class="coin-icon">🪙</text>
      <text class="coin-num">{{gameStats.coins}}</text>
    </view>
  </view>

  <!-- 游戏入口列表标题 -->
  <view class="section-title-bar">
    <text class="section-title">🐭 鼠鼠菜单</text>
    <text class="section-sub">选择游戏开启挑战</text>
  </view>

  <!-- 游戏卡片列表 (基于微信原生 navigator 组件实现底层零延迟路由分发) -->
  <view class="game-cards-list">
    <block wx:for="{{gameList}}" wx:key="id">
      <navigator url="{{item.path}}" hover-class="none" class="game-card" bindtap="onCardTap">
        <!-- 上半部分：图标 + 标题/标签 + 描述 -->
        <view class="card-main">
          <view class="game-icon-box" style="background: {{item.bgGradient}}; {{item.boxStyle || ''}}">
            <image wx:if="{{item.iconUrl}}" class="game-icon-img" src="{{item.iconUrl}}" mode="aspectFit"></image>
            <text wx:else class="game-icon">{{item.icon}}</text>
          </view>
          <view class="game-info">
            <view class="game-header">
              <text class="game-title">{{item.title}}</text>
              <text class="game-tag">{{item.tag}}</text>
            </view>
            <text class="game-desc">{{item.desc}}</text>
          </view>
        </view>

        <!-- 卡片内分割线 -->
        <view class="card-divider"></view>

        <!-- 下半部分：战绩 (如合成非洲之心数 / 今日运势) + 进入按钮 -->
        <view class="card-footer">
          <view class="game-record">
            <text class="record-label">{{item.recordLabel}}：</text>
            <text class="record-val">{{item.recordVal}}</text>
          </view>
          <view class="enter-btn-pill">
            <text class="btn-text">进入游玩</text>
            <text class="btn-arrow">›</text>
          </view>
        </view>
      </navigator>
    </block>
  </view>

  <!-- 底部快捷设置 -->
  <view class="footer-settings">
    <view class="setting-item">
      <text class="setting-text">震动反馈</text>
      <switch checked="{{settings.vibrationEnabled}}" bindchange="onToggleVibration" color="#89b4fa" />
    </view>
    <view class="setting-item">
      <text class="setting-text">游戏音效</text>
      <switch checked="{{settings.soundEnabled}}" bindchange="onToggleSound" color="#89b4fa" />
    </view>
  </view>

  <!-- 特勤登录提醒弹窗 (首次进入未登录自动提醒，亦可点击顶部游客栏呼出) -->
  <view wx:if="{{showLoginModal}}" class="login-modal-mask" catchtouchmove="preventTouchMove">
    <view class="login-modal-card">
      <view class="login-modal-header">
        <view class="modal-badge">
          <text class="modal-badge-icon">🛡️</text>
          <text class="modal-badge-title">战区特勤通行证</text>
        </view>
        <view class="modal-close-btn" bindtap="onCloseLoginModal">✕</view>
      </view>

      <view class="login-modal-body">
        <view class="modal-tip-box">
          <text class="modal-tip-title">欢迎来到特勤大厅！</text>
          <text class="modal-tip-desc">检测到您当前处于离线游客状态。连接微信登录可同步全盘游戏战绩与特权配置。</text>
        </view>
        <view class="modal-profile-preview-card">
          <image class="modal-preview-avatar" src="{{userProfile.avatarUrl}}" mode="aspectFill"></image>
          <view class="modal-preview-info">
            <text class="modal-preview-name">{{userProfile.nickName || '野生鼠鼠'}}</text>
            <text class="modal-preview-status">特勤通行证待连接</text>
          </view>
        </view>
      </view>

      <view class="login-modal-footer">
        <button class="modal-login-btn" bindtap="onConfirmModalLogin" loading="{{isLoggingIn}}">
          <text class="modal-login-btn-icon">⚡</text>
          <text class="modal-login-btn-text">微信一键登录</text>
        </button>
        <view class="modal-guest-btn" bindtap="onCloseLoginModal">
          <text class="guest-btn-text">暂不登录，以游客身份继续体验 ›</text>
        </view>
      </view>
    </view>
  </view>
</view>
