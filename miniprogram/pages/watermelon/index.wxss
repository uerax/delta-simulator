/**
 * pages/watermelon/index.wxss
 * 暗夜战术摸金风格：深邃碳黑底色、全息荧光与品质光效
 */

page {
  height: 100%;
  background-color: #0d1117;
  color: #c9d1d9;
  font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif;
  overflow: hidden;
}

.watermelon-container {
  display: flex;
  flex-direction: column;
  height: 100vh;
  box-sizing: border-box;
  padding: 16rpx 20rpx env(safe-area-inset-bottom, 20rpx);
  position: relative;
  background-color: #0d1117;
  opacity: 1;
}

/* 顶部状态栏 */
.status-bar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  background: rgba(22, 27, 34, 0.95);
  border: 1rpx solid rgba(48, 54, 61, 0.8);
  border-radius: 16rpx;
  padding: 16rpx 24rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.4);
  margin-bottom: 12rpx;
}

.status-item {
  display: flex;
  flex-direction: column;
}

.money-item {
  flex: 1.2;
}

.score-item {
  flex: 0.9;
  text-align: center;
}

.label {
  font-size: 20rpx;
  color: #8b949e;
  margin-bottom: 4rpx;
  letter-spacing: 1rpx;
}

.money-value {
  font-size: 32rpx;
  font-weight: 700;
  color: #fbbf24;
  text-shadow: 0 2rpx 8rpx rgba(251, 191, 36, 0.35);
}

.score-value {
  font-size: 32rpx;
  font-weight: 700;
  color: #34d399;
  text-shadow: 0 2rpx 8rpx rgba(52, 211, 153, 0.35);
}

.next-item-box {
  display: flex;
  flex-direction: column;
  align-items: center;
  min-width: 80rpx;
}

.next-preview-circle {
  width: 52rpx;
  height: 52rpx;
  border-radius: 50%;
  border: 2rpx solid #10b981;
  background: #161b22;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 0 10rpx rgba(16, 185, 129, 0.3);
  overflow: hidden;
}

.next-preview-img {
  width: 44rpx;
  height: 44rpx;
}

/* 浮动提示区 */
.floating-banner-container {
  height: 40rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 8rpx;
  position: relative;
}

.combo-tag {
  opacity: 0;
  transform: scale(0.8);
  transition: all 0.2s ease-out;
  background: linear-gradient(135deg, #f59e0b, #ef4444);
  color: #ffffff;
  font-size: 22rpx;
  font-weight: 700;
  padding: 4rpx 18rpx;
  border-radius: 20rpx;
  box-shadow: 0 2rpx 10rpx rgba(239, 68, 68, 0.4);
}

.combo-tag.show {
  opacity: 1;
  transform: scale(1);
}

.danger-warning-tag {
  opacity: 0;
  position: absolute;
  transition: opacity 0.3s ease;
  background: rgba(224, 58, 62, 0.25);
  border: 1rpx solid #e03a3e;
  border-radius: 12rpx;
  padding: 4rpx 16rpx;
}

.danger-warning-tag.show {
  opacity: 1;
  animation: pulse 1s infinite alternate;
}

.warning-text {
  font-size: 20rpx;
  color: #ff6b6b;
  font-weight: 600;
}

@keyframes pulse {
  0% { transform: scale(0.98); opacity: 0.8; }
  100% { transform: scale(1.02); opacity: 1; }
}

/* 画布主区域 (1:1 严格锁定斗鱼官方 STAGE_LAYOUT 702:976 舞台长宽比例) */
.canvas-wrap {
  width: 100%;
  aspect-ratio: 702 / 976;
  max-height: calc(100vh - 300rpx);
  border-radius: 20rpx;
  overflow: hidden;
  background: #090d13;
  border: 2rpx solid #21262d;
  box-shadow: inset 0 0 30rpx rgba(0, 0, 0, 0.8), 0 8rpx 24rpx rgba(0, 0, 0, 0.5);
  position: relative;
  z-index: 1;
  box-sizing: border-box;
  flex-shrink: 0;
  margin: 0 auto;
}

.canvas-wrap.canvas-hidden,
.game-canvas.canvas-hidden {
  visibility: hidden !important;
  opacity: 0 !important;
  pointer-events: none !important;
}

.game-canvas {
  width: 100%;
  height: 100%;
  display: block;
  position: relative;
  z-index: 1;
}

/* 预留流量主广告展示区 (全面屏多出长度自适应吸收并居中排布) */
.ad-container-placeholder {
  flex: 1;
  width: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 80rpx;
  padding: 10rpx 0;
  box-sizing: border-box;
}

.ad-placeholder-box {
  width: 100%;
  height: 100%;
  max-height: 140rpx;
  border: 1rpx dashed rgba(255, 255, 255, 0.12);
  border-radius: 14rpx;
  background: rgba(22, 27, 34, 0.5);
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  box-sizing: border-box;
  padding: 0 20rpx;
}

.ad-placeholder-badge {
  font-size: 18rpx;
  color: #8b949e;
  background: rgba(255, 255, 255, 0.08);
  border: 1rpx solid rgba(255, 255, 255, 0.12);
  padding: 2rpx 10rpx;
  border-radius: 6rpx;
  font-weight: 500;
  letter-spacing: 1rpx;
}

.ad-placeholder-text {
  font-size: 20rpx;
  color: #6e7681;
  font-family: monospace;
  letter-spacing: 1rpx;
}

/* 结算弹窗宿主层级 (确保高过 Canvas 2D 原生同层渲染) */
game-result-modal {
  position: relative;
  z-index: 999999;
}

/* 底部操作栏 */
.bottom-bar {
  display: flex;
  gap: 20rpx;
  padding-top: 16rpx;
}

.action-btn {
  flex: 1;
  height: 72rpx;
  line-height: 72rpx;
  font-size: 26rpx;
  font-weight: 600;
  border-radius: 14rpx;
  padding: 0;
  margin: 0;
}

.secondary-btn {
  background: #21262d;
  color: #8b949e;
  border: 1rpx solid #30363d;
}

.secondary-btn:active {
  background: #30363d;
}

.primary-btn {
  background: linear-gradient(135deg, #10b981, #059669);
  color: #ffffff;
  border: none;
  box-shadow: 0 4rpx 12rpx rgba(16, 185, 129, 0.35);
}

.primary-btn:active {
  opacity: 0.85;
}
