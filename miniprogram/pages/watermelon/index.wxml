<view class="watermelon-container {{pageReady ? 'page-ready' : ''}}">
  <!-- 顶部状态栏：搜刮身价、得分与下一个道具预览 -->
  <view class="status-bar">
    <view class="status-item money-item">
      <text class="label">搜刮总身价</text>
      <text class="value money-value">¥ {{moneyFormatted}}</text>
    </view>
    <view class="status-item score-item">
      <text class="label">合成非洲之心数</text>
      <text class="value score-value">{{watermelonCount}}</text>
    </view>
    <view class="status-item next-item-box" wx:if="{{nextItem}}">
      <text class="label">下一个</text>
      <view class="next-preview-circle" style="border-color: {{nextItem.colorHex}};">
        <image class="next-preview-img" src="{{nextItem.iconUrl}}" mode="aspectFit" />
      </view>
    </view>
  </view>

  <!-- 连击提示与警戒浮动提示 -->
  <view class="floating-banner-container">
    <view class="combo-tag {{combo > 1 ? 'show' : ''}}">
      <text class="combo-text">⚡ {{combo}} 连击！</text>
    </view>
    <view class="danger-warning-tag {{isWarning ? 'show' : ''}}">
      <text class="warning-text">⚠️ 堆叠过高，请尽快合成！</text>
    </view>
  </view>

  <!-- 核心物理渲染画布 (Canvas 2D) -->
  <view
    class="canvas-wrap {{showResultModal ? 'canvas-hidden' : ''}}"
    id="canvasWrap"
    style="visibility: {{showResultModal ? 'hidden' : 'visible'}}; pointer-events: {{showResultModal ? 'none' : 'auto'}};"
  >
    <canvas
      type="2d"
      id="gameCanvas"
      class="game-canvas {{showResultModal ? 'canvas-hidden' : ''}}"
      bindtouchstart="onTouchStart"
      bindtouchmove="onTouchMove"
      bindtouchend="onTouchEnd"
    />
  </view>

  <!-- 预留流量主广告展示位 (全面屏多出长度自适应承载，居中排布) -->
  <view class="ad-container-placeholder">
    <view class="ad-placeholder-box">
      <view class="ad-placeholder-badge">广告赞助</view>
      <text class="ad-placeholder-text">战术补给展位 (预留接入微信流量主广告)</text>
    </view>
  </view>

  <!-- 底部快捷操作栏 -->
  <view class="bottom-bar">
    <button class="action-btn secondary-btn" bindtap="goHome">返回大厅</button>
    <button class="action-btn primary-btn" bindtap="restartGame">重新开始</button>
  </view>

  <!-- 通用结算弹窗组件 -->
  <game-result-modal
    visible="{{showResultModal}}"
    title="{{modalTitle}}"
    isNewRecord="{{isNewRecord}}"
    badgeText="🏆 刷新最高搜刮记录！"
    items="{{resultItems}}"
    primaryBtnText="再来一局"
    secondaryBtnText="返回大厅"
    bindrestart="restartGame"
    bindhome="goHome"
  />
</view>
