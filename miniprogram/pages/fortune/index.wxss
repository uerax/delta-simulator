/* pages/fortune/index.wxss */
page {
  background-color: #1e1e2e;
  color: #cdd6f4;
  min-height: 100vh;
  box-sizing: border-box;
}

.fortune-container {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 60rpx 40rpx;
  min-height: 90vh;
  box-sizing: border-box;
}

.placeholder-card {
  width: 100%;
  background: #313244;
  border: 2rpx solid #45475a;
  border-radius: 36rpx;
  padding: 60rpx 40rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  box-shadow: 0 16rpx 40rpx rgba(0, 0, 0, 0.4);
  box-sizing: border-box;
  text-align: center;
}

.icon-bubble {
  width: 160rpx;
  height: 160rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, rgba(224, 58, 62, 0.45) 0%, #361a1c 100%);
  border: 3rpx solid #E03A3E;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 32rpx;
  box-shadow: 0 0 35rpx rgba(224, 58, 62, 0.4);
}

.fortune-icon-img {
  width: 120rpx;
  height: 120rpx;
  display: block;
}

.title {
  font-size: 44rpx;
  font-weight: bold;
  color: #cdd6f4;
  margin-bottom: 16rpx;
}

.badge {
  display: inline-block;
  background: rgba(224, 58, 62, 0.15);
  color: #fab387;
  border: 1rpx solid rgba(224, 58, 62, 0.4);
  padding: 8rpx 24rpx;
  border-radius: 30rpx;
  font-size: 24rpx;
  margin-bottom: 32rpx;
}

.desc {
  font-size: 28rpx;
  color: #bac2de;
  line-height: 1.6;
  margin-bottom: 24rpx;
}

.tips {
  font-size: 24rpx;
  color: #a6adc8;
  background: #1e1e2e;
  padding: 24rpx;
  border-radius: 20rpx;
  width: 100%;
  margin-bottom: 48rpx;
  box-sizing: border-box;
  line-height: 1.5;
}

.back-btn {
  background: linear-gradient(135deg, #E03A3E, #fab387);
  color: #11111b;
  font-weight: bold;
  font-size: 32rpx;
  border-radius: 40rpx;
  padding: 20rpx 60rpx;
  border: none;
  width: 100%;
  box-shadow: 0 8rpx 24rpx rgba(224, 58, 62, 0.35);
}

.back-btn::after {
  border: none;
}
