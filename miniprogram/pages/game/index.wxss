/* pages/game/index.wxss */
page {
  background-color: #1e1e2e;
  color: #cdd6f4;
  height: 100vh;
  box-sizing: border-box;
}

.game-container {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 40rpx 32rpx;
  min-height: 100vh;
  box-sizing: border-box;
}

/* 顶部状态栏 */
.status-bar {
  width: 100%;
  display: flex;
  justify-content: space-around;
  background: #313244;
  border-radius: 20rpx;
  padding: 24rpx 16rpx;
  box-shadow: 0 8rpx 24rpx rgba(0, 0, 0, 0.3);
  margin-bottom: 50rpx;
}

.status-item {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.status-item .label {
  font-size: 24rpx;
  color: #a6adc8;
  margin-bottom: 8rpx;
}

.status-item .value {
  font-size: 40rpx;
  font-weight: bold;
}

.time-value {
  color: #89b4fa;
}

.time-value.danger {
  color: #f38ba8;
  animation: pulse 0.5s infinite alternate;
}

.score-value {
  color: #a6e3a1;
}

.combo-value {
  color: #f9e2af;
}

/* 九宫格棋盘 */
.grid-board {
  width: 620rpx;
  height: 620rpx;
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  grid-template-rows: repeat(3, 1fr);
  gap: 24rpx;
  margin-bottom: 40rpx;
}

.grid-cell {
  background: #313244;
  border-radius: 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 64rpx;
  transition: all 0.15s ease-out;
  box-shadow: inset 0 2rpx 6rpx rgba(255, 255, 255, 0.05), 0 8rpx 16rpx rgba(0, 0, 0, 0.2);
}

.grid-cell:active {
  transform: scale(0.95);
}

.grid-cell.cell-active {
  background: linear-gradient(135deg, #f38ba8, #fab387);
  box-shadow: 0 0 30rpx rgba(243, 139, 168, 0.6);
  transform: scale(1.02);
}

.grid-cell.cell-wrong {
  background: #585b70;
  animation: shake 0.3s ease-in-out;
}

.active-pulse {
  animation: popIn 0.2s cubic-bezier(0.175, 0.885, 0.32, 1.275);
}

/* 底部提示 */
.footer-tips {
  font-size: 28rpx;
  color: #a6adc8;
  margin-top: 20rpx;
  height: 48rpx;
}

.action-btn-area {
  margin-top: 40rpx;
  width: 100%;
}

.start-btn {
  background: linear-gradient(135deg, #89b4fa, #b4befe);
  color: #11111b;
  font-weight: bold;
  font-size: 34rpx;
  border-radius: 48rpx;
  padding: 24rpx 0;
  box-shadow: 0 8rpx 24rpx rgba(137, 180, 250, 0.4);
}

@keyframes pulse {
  from { transform: scale(1); }
  to { transform: scale(1.1); }
}

@keyframes popIn {
  from { transform: scale(0.8); opacity: 0; }
  to { transform: scale(1); opacity: 1; }
}

@keyframes shake {
  0%, 100% { transform: translateX(0); }
  25% { transform: translateX(-10rpx); }
  75% { transform: translateX(10rpx); }
}
