/* pages/schulte/index.wxss */
page {
  background-color: #1e1e2e;
  color: #cdd6f4;
  min-height: 100vh;
}

.schulte-container {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 40rpx 32rpx;
  box-sizing: border-box;
}

/* 顶部状态栏 */
.status-bar {
  width: 100%;
  display: flex;
  justify-content: space-around;
  background: #313244;
  border-radius: 20rpx;
  padding: 24rpx 16rpx;
  box-shadow: 0 8rpx 24rpx rgba(0, 0, 0, 0.3);
  margin-bottom: 40rpx;
}

.status-item {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.status-item .label {
  font-size: 24rpx;
  color: #a6adc8;
  margin-bottom: 8rpx;
}

.status-item .value {
  font-size: 40rpx;
  font-weight: bold;
}

.time-value {
  color: #89b4fa;
}

.target-value {
  color: #f9e2af;
  font-size: 48rpx;
}

.remain-value {
  color: #a6e3a1;
}

/* 4x4 棋盘 */
.schulte-grid {
  width: 640rpx;
  height: 640rpx;
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  grid-template-rows: repeat(4, 1fr);
  gap: 16rpx;
  margin-bottom: 40rpx;
}

.grid-box {
  background: #313244;
  border-radius: 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border: 2rpx solid #45475a;
  transition: all 0.15s ease-out;
}

.grid-box:active {
  transform: scale(0.92);
}

.box-num {
  font-size: 48rpx;
  font-weight: bold;
  color: #cdd6f4;
}

.grid-box.cleared {
  background: #181825;
  border-color: #313244;
  opacity: 0.3;
  pointer-events: none;
}

.grid-box.cleared .box-num {
  color: #585b70;
}

.grid-box.wrong {
  background: #f38ba8;
  animation: shake 0.3s ease-in-out;
}

.footer-tips {
  font-size: 28rpx;
  color: #a6adc8;
  margin-top: 10rpx;
  height: 48rpx;
}

.action-btn-area {
  margin-top: 40rpx;
  width: 100%;
}

.start-btn {
  background: linear-gradient(135deg, #f9e2af, #fab387);
  color: #11111b;
  font-weight: bold;
  font-size: 34rpx;
  border-radius: 48rpx;
  padding: 24rpx 0;
  box-shadow: 0 8rpx 24rpx rgba(249, 226, 175, 0.4);
}

@keyframes shake {
  0%, 100% { transform: translateX(0); }
  25% { transform: translateX(-10rpx); }
  75% { transform: translateX(10rpx); }
}
