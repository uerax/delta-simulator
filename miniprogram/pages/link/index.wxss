/**
 * miniprogram/pages/link/index.wxss
 * 鼠鼠连连看 - 横屏战术机能暗黑样式 (全 px 紧凑像素级锁死，杜绝任何换行与截断)
 */

page {
  width: 100vw;
  height: 100vh;
  overflow: hidden;
  background-color: #0d1117;
  color: #e6edf3;
  font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
  user-select: none;
  margin: 0;
  padding: 0;
}

.link-container {
  width: 100vw;
  height: 100vh;
  display: flex;
  flex-direction: column;
  background-color: #0d1117;
  overflow: hidden;
  box-sizing: border-box;
  opacity: 0;
  transition: opacity 0.25s cubic-bezier(0.4, 0, 0.2, 1);
}

.link-container.page-ready {
  opacity: 1;
}

/* ============================================================
   顶部战术状态与道具栏 (横屏锁定 42px)
   ============================================================ */
.top-status-bar {
  height: 42px;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0 16px;
  background: rgba(13, 17, 23, 0.92);
  backdrop-filter: blur(12px);
  border-bottom: 1px solid rgba(255, 255, 255, 0.08);
  flex-shrink: 0;
  z-index: 10;
  box-sizing: border-box;
}

.status-group {
  display: flex;
  align-items: center;
  gap: 10px;
  flex-shrink: 0;
  white-space: nowrap;
}

.status-badge {
  display: inline-flex;
  align-items: center;
  gap: 4px;
  height: 26px;
  line-height: 26px;
  padding: 0 10px;
  border-radius: 13px;
  background: rgba(255, 255, 255, 0.06);
  border: 1px solid rgba(255, 255, 255, 0.12);
  font-size: 13px;
  font-weight: 600;
  color: #e6edf3;
  white-space: nowrap;
  flex-shrink: 0;
  box-sizing: border-box;
}

.stage-badge {
  background: rgba(137, 180, 250, 0.12);
  border-color: rgba(137, 180, 250, 0.35);
  color: #89b4fa;
}

.timer-badge {
  background: rgba(49, 50, 68, 0.5);
  font-family: monospace;
}

.timer-badge.timer-danger {
  background: rgba(224, 58, 62, 0.2);
  border-color: #e03a3e;
  color: #ff6b4a;
  animation: timerPulse 0.8s infinite alternate;
}

@keyframes timerPulse {
  0% { transform: scale(1); opacity: 0.9; }
  100% { transform: scale(1.05); opacity: 1; }
}

/* 中间：身价与连击 */
.money-box {
  display: inline-flex;
  align-items: center;
  gap: 6px;
  height: 26px;
  background: rgba(245, 158, 11, 0.08);
  border: 1px solid rgba(245, 158, 11, 0.3);
  padding: 0 12px;
  border-radius: 13px;
  white-space: nowrap;
  flex-shrink: 0;
  box-sizing: border-box;
}

.money-label {
  font-size: 11px;
  color: #9ca3af;
  white-space: nowrap;
}

.money-val {
  font-size: 15px;
  font-weight: 800;
  color: #f59e0b;
  font-family: monospace;
  white-space: nowrap;
}

.combo-pill {
  height: 24px;
  line-height: 24px;
  padding: 0 10px;
  border-radius: 12px;
  background: linear-gradient(135deg, #ff6b4a, #e03a3e);
  color: #ffffff;
  font-size: 12px;
  font-weight: bold;
  box-shadow: 0 2px 8px rgba(224, 58, 62, 0.4);
  white-space: nowrap;
  flex-shrink: 0;
  animation: comboPop 0.2s cubic-bezier(0.175, 0.885, 0.32, 1.275);
}

@keyframes comboPop {
  0% { transform: scale(0.8); }
  100% { transform: scale(1); }
}

/* 右侧道具区 */
.tool-btn {
  display: inline-flex;
  align-items: center;
  gap: 5px;
  height: 26px;
  padding: 0 10px;
  background: rgba(255, 255, 255, 0.06);
  border: 1px solid rgba(255, 255, 255, 0.12);
  border-radius: 13px;
  font-size: 12px;
  color: #e6edf3;
  white-space: nowrap;
  flex-shrink: 0;
  box-sizing: border-box;
}

.tool-btn:active {
  background: rgba(255, 255, 255, 0.15);
  transform: scale(0.96);
}

.hammer-tool.active {
  background: rgba(224, 58, 62, 0.25);
  border-color: #e03a3e;
  color: #ff6b4a;
  box-shadow: 0 0 12px rgba(224, 58, 62, 0.4);
}

.hammer-icon-wrap {
  position: relative;
  display: inline-flex;
  align-items: center;
}

.hammer-count-badge {
  position: absolute;
  top: -6px;
  right: -8px;
  min-width: 14px;
  height: 14px;
  line-height: 14px;
  padding: 0 3px;
  border-radius: 7px;
  background: #e03a3e;
  color: #ffffff;
  font-size: 10px;
  font-weight: 800;
  text-align: center;
}

.hammer-count-badge.empty {
  background: #6b7280;
}

/* 消除锤悬浮战术微型胶囊提示 (轻盈悬浮在画布上方，绝不占用布局空间) */
.floating-hammer-pill {
  position: absolute;
  top: 10px;
  left: 50%;
  transform: translateX(-50%);
  height: 26px;
  display: inline-flex;
  align-items: center;
  gap: 8px;
  padding: 0 12px;
  background: rgba(30, 20, 24, 0.92);
  border: 1px solid #e03a3e;
  border-radius: 13px;
  box-shadow: 0 2px 12px rgba(224, 58, 62, 0.4);
  z-index: 20;
  white-space: nowrap;
  pointer-events: auto;
  animation: pillFadeIn 0.2s ease-out;
}

@keyframes pillFadeIn {
  0% { opacity: 0; transform: translate(-50%, -6px); }
  100% { opacity: 1; transform: translate(-50%, 0); }
}

.pill-text {
  font-size: 12px;
  font-weight: 600;
  color: #ff9b9b;
}

.pill-cancel-btn {
  font-size: 11px;
  padding: 1px 6px;
  border-radius: 4px;
  background: rgba(255, 255, 255, 0.15);
  color: #ffffff;
}

.pill-cancel-btn:active {
  background: rgba(255, 255, 255, 0.3);
}

/* ============================================================
   Canvas 画布核心区 (横屏占据主要视野)
   ============================================================ */
.canvas-wrap {
  flex: 1;
  min-height: 0;
  width: 100%;
  display: flex;
  justify-content: center;
  align-items: center;
  position: relative;
  background-color: #10121a;
  box-sizing: border-box;
}

.canvas-wrap.canvas-hidden,
.game-canvas.canvas-hidden {
  visibility: hidden !important;
  pointer-events: none !important;
}

.game-canvas {
  width: 100%;
  height: 100%;
  display: block;
}

.restart-tool {
  background: rgba(224, 58, 62, 0.12);
  border-color: rgba(224, 58, 62, 0.35);
  color: #ff9b9b;
}

.restart-tool:active {
  background: rgba(224, 58, 62, 0.25);
  color: #ffffff;
}
