/* components/game-result-modal/index.wxss */
.modal-overlay {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.75);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 999;
}

.result-modal {
  width: 600rpx;
  background: #1e1e2e;
  border: 2rpx solid #45475a;
  border-radius: 32rpx;
  padding: 48rpx 36rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  box-shadow: 0 20rpx 50rpx rgba(0, 0, 0, 0.5);
  animation: popIn 0.3s ease-out;
  box-sizing: border-box;
}

.modal-title {
  font-size: 40rpx;
  font-weight: bold;
  color: #cdd6f4;
  margin-bottom: 24rpx;
}

.new-record-badge {
  background: #f9e2af;
  color: #11111b;
  font-size: 26rpx;
  font-weight: bold;
  padding: 8rpx 24rpx;
  border-radius: 30rpx;
  margin-bottom: 24rpx;
}

.result-list {
  width: 100%;
  background: #313244;
  border-radius: 20rpx;
  padding: 24rpx;
  margin-bottom: 36rpx;
  box-sizing: border-box;
}

.result-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 12rpx 0;
  font-size: 28rpx;
}

.row-label {
  color: #a6adc8;
}

.row-value {
  color: #cdd6f4;
  font-weight: bold;
}

.row-value.highlight {
  font-size: 36rpx;
  color: #fab387;
}

.modal-actions {
  width: 100%;
  display: flex;
  gap: 20rpx;
}

.modal-btn {
  flex: 1;
  font-size: 30rpx;
  font-weight: bold;
  border-radius: 36rpx;
  padding: 20rpx 0;
  border: none;
  display: flex;
  align-items: center;
  justify-content: center;
}

.modal-btn::after {
  border: none;
}

.play-again-btn {
  background: #89b4fa;
  color: #11111b;
}

.back-home-btn {
  background: #45475a;
  color: #cdd6f4;
}

@keyframes popIn {
  from {
    transform: scale(0.8);
    opacity: 0;
  }
  to {
    transform: scale(1);
    opacity: 1;
  }
}
